# LLM Provider Configuration
# Choose one of: 'groq' (recommended free tier), 'gemini', 'anthropic', 'openai'
LLM_PROVIDER=groq

# 1. Groq (Free fast inference - https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
# Available Groq free models:
# - openai/gpt-oss-120b (Recommended best: 120B parameter model, state-of-the-art open weights)
# - openai/gpt-oss-20b (Fast 20B model)
# - qwen/qwen3.6-27b (Qwen 27B)
MODEL_NAME=openai/gpt-oss-120b



# 2. Google Gemini (Free tier - https://aistudio.google.com)
# GEMINI_API_KEY=your_gemini_api_key_here
# MODEL_NAME=gemini-2.0-flash

# 3. Anthropic Claude (Paid)
# ANTHROPIC_API_KEY=your_anthropic_key_here
# MODEL_NAME=claude-3-7-sonnet-20250219

# Server settings
PORT=5007

# Agent settings
RECALL_PASS_THRESHOLD=0.7
MAX_RETRIES=3


# Optional: LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_key
LANGCHAIN_PROJECT=paper-tutor-agent

